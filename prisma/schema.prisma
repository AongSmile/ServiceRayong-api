generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Supabase pooler :6543
  directUrl = env("DIRECT_URL")     // Supabase direct :5432 (ใช้ตอน migrate)
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum SystemType {
  CORE
  EXTERNAL
}

enum SystemStatus {
  ACTIVE
  MAINTENANCE
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum SenderRole {
  VISITOR
  AGENT
  SYSTEM
}

enum ConsentType {
  COOKIES_NECESSARY
  COOKIES_FUNCTIONAL
  CHAT
}

enum PrivacyRequestType {
  ACCESS
  ERASURE
  WITHDRAW
}

enum PrivacyRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique
  passwordHash  String?                 // เปลี่ยนเป็น nullable — เผื่ออนาคตบัญชีที่ใช้ ThaiID อย่างเดียว
  name          String
  role          Role        @default(USER)
  status        UserStatus  @default(ACTIVE)   // ใหม่: ระงับ/เปิดใช้งาน
  extraPerms    String[]    @default([])       // ใหม่: สิทธิ์เพิ่มนอกบทบาท
  blockedPerms  String[]    @default([])       // ใหม่: สิทธิ์ที่ปิดเฉพาะบุคคล
  thaiidHash    String?     @unique            // เผื่อ ThaiID — ตอนนี้ยังไม่มีโค้ดใช้ วางไว้ได้ไม่กระทบอะไร (หรือลบบรรทัดนี้ทิ้งก็ได้)
  lastLoginAt   DateTime?                       // ใหม่: เวลาเข้าใช้ล่าสุด
  createdAt     DateTime    @default(now())

  refreshTokens RefreshToken[]
  systems       System[]
  assignedChats ChatSession[]  @relation("assignedChats")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model System {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  type        SystemType
  name        String
  description String       @default("")
  url         String
  tags        String[]
  status      SystemStatus @default(ACTIVE)
  searchText  String       @default("")
  sortOrder   Int          @default(0)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type, status])
  @@index([searchText])
}

model ChatSession {
  id               String        @id @default(uuid()) @db.Uuid
  visitorName      String
  visitorToken     String        @unique
  status           ChatStatus    @default(OPEN)
  unreadForAgent   Int           @default(0)
  unreadForVisitor Int           @default(0)
  lastMessageAt    DateTime      @default(now())
  assignedTo       User?         @relation("assignedChats", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId     String?       @db.Uuid
  createdAt        DateTime      @default(now())
  messages         ChatMessage[]

  @@index([status, lastMessageAt])
}

model ChatMessage {
  id         String      @id @default(uuid()) @db.Uuid
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String      @db.Uuid
  senderRole SenderRole
  senderName String
  body       String
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model ConsentLog {
  id            String      @id @default(uuid()) @db.Uuid
  consentType   ConsentType
  granted       Boolean
  visitorHash   String      @default("") // hash ของ visitor token หรือ IP — ไม่เก็บค่าจริง
  ipHash        String      @default("") // IP เข้ารหัส SHA-256 + salt ก่อนเก็บเสมอ
  userAgent     String      @default("")
  policyVersion String      @default("1.0")
  createdAt     DateTime    @default(now())
  withdrawnAt   DateTime?

  @@index([visitorHash])
  @@index([consentType, createdAt])
}

model PrivacyRequest {
  id          String               @id @default(uuid()) @db.Uuid
  reqType     PrivacyRequestType
  status      PrivacyRequestStatus @default(PENDING)
  contact     String
  detail      String               @default("")
  visitorHash String               @default("")
  handledBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorEmail String
  action     String
  target     String   @default("")
  ipHash     String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}